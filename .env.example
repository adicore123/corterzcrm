# Absolute path on a persistent disk in production. Defaults to ./storage.
# CORTEZ_STORAGE_DIR=/var/lib/cortez
# Public origin used behind a TLS reverse proxy.
# CORTEZ_ORIGIN=https://crm.example.com
# Vercel automatically enables the private Blob backend once a store is connected.
# For local commands explicitly targeting the connected store:
# CORTEZ_STORAGE_BACKEND=blob
# BLOB_READ_WRITE_TOKEN=
